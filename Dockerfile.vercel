# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY DentalClinic.csproj ./
RUN dotnet restore ./DentalClinic.csproj

COPY . .
RUN dotnet publish ./DentalClinic.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# .NET 10 images already provide the non-root `app` user and APP_UID.
# Keep the published tree and avatar upload directory writable by that user
# instead of trying to install/create another account in the runtime image.
COPY --from=build /app/publish .
RUN mkdir -p /app/wwwroot/uploads/avatars \
    && chown -R app:app /app

USER $APP_UID
ENV ASPNETCORE_ENVIRONMENT=Production

# Vercel передаёт порт контейнеру через PORT. Значение 8080 оставлено
# запасным для локальной проверки образа.
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec dotnet DentalClinic.dll --urls http://0.0.0.0:${PORT:-8080}"]
