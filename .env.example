# Скопируйте этот файл в .env и впишите свои значения.
# .env уже добавлен в .gitignore — реальные секреты в репозиторий не попадут.

# Пароль sa для контейнера SQL Server (мин. 8 симв., буквы разного регистра + цифра/спецсимвол)
DB_SA_PASSWORD=ВашСложныйПароль123!

# Случайная строка минимум 32 символа для подписи JWT
JWT_KEY=вставьте_сюда_случайную_строку_минимум_32_символа

# Ключ Google Gemini API (для AI-чат-бота)
GEMINI_API_KEY=вставьте_ваш_ключ

# (опционально) ключ ElevenLabs для озвучки ответов бота
ELEVENLABS_API_KEY=

# Домен фронтенда, с которого разрешены запросы к API (CORS)
FRONTEND_ORIGIN=http://localhost:8080

# Публичный профиль клиники для локального/демо-запуска.
# Эти значения не являются реальными контактами клиники и должны быть заменены перед production.
# Часы синхронизированы с Scheduling: Пн-Сб 09:00-20:00, Вс закрыто.
# Координаты можно оставить пустыми: страница контактов построит карту по адресу.
CLINIC_PHONE=+7 (8442) 00-00-00
CLINIC_EMAIL=info@denta-volgograd.example
CLINIC_ADDRESS=Волгоград, проспект Ленина, 1
CLINIC_HOURS=Пн-Сб 09:00-20:00; Вс — выходной
CLINIC_LATITUDE=
CLINIC_LONGITUDE=

# Production secrets and the real public clinic profile are managed in Vercel Project Settings,
# not in this file. Do not deploy these demo contacts as production facts.