{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance/reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/maintenance/follow-ups",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/maintenance/cleanup",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/maintenance/chat-retention",
      "schedule": "30 6 * * *"
    }
  ]
}
